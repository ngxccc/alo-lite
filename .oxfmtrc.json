{
  "arrowParens": "always",
  "tabWidth": 2,
  "useTabs": false,
  "printWidth": 100,
  "proseWrap": "preserve",
  "semi": true,
  "endOfLine": "lf",
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/target/**",
    "re-notes/**",
    "graphify-out/**",
    "temp/**",
    "accounts/**",
    ".*/**",
    "**/*.generated.ts"
  ]
}
