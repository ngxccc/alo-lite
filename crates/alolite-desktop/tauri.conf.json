{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AloLite",
  "version": "0.0.1",
  "identifier": "io.github.ngxccc.alolite",
  "mainBinaryName": "alolite-desktop",
  "build": {
    "beforeDevCommand": "cd ../../apps/desktop && bun run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "cd ../../apps/desktop && bun run build",
    "frontendDist": "../../apps/desktop/dist"
  },
  "app": {
    "windows": [
      {
        "title": "AloLite",
        "width": 1200,
        "height": 780,
        "minWidth": 880,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' data: blob:; img-src 'self' data: blob: https://*.zdn.vn https://*.zaloapp.com https://*.zadn.vn https://*.dlmd.me; media-src 'self' data: blob: https://*.dlmd.me https://*.zdn.vn https://*.zaloapp.com https://*.zadn.vn; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../alolite-core/assets/app_icon.png",
      "../alolite-core/assets/app_icon.ico"
    ]
  }
}
